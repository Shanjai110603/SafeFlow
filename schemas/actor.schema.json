{
  "additionalProperties": false,
  "description": "Platform actor (user or channel), identified pseudonymously.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "description": "Canonical schema semantic version",
      "title": "Schema Version",
      "type": "string"
    },
    "actor_id": {
      "description": "Pseudonymous actor identifier (salted HMAC)",
      "title": "Actor Id",
      "type": "string"
    },
    "platform_id": {
      "description": "Platform identifier (e.g. video_comments, forum_communities)",
      "title": "Platform Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "display_name_hash": {
      "description": "Cryptographic hash of the display name",
      "title": "Display Name Hash",
      "type": "string"
    },
    "description_history": {
      "description": "Historical bio/profile texts",
      "items": {
        "type": "string"
      },
      "title": "Description History",
      "type": "array"
    },
    "avatar_media_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Current avatar media identifier",
      "title": "Avatar Media Id"
    },
    "attributes": {
      "additionalProperties": true,
      "description": "Platform-neutral attributes",
      "title": "Attributes",
      "type": "object"
    }
  },
  "required": [
    "actor_id",
    "platform_id",
    "display_name_hash"
  ],
  "title": "Actor",
  "type": "object"
}