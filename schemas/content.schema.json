      "title": "Schema Version",
      "type": "string"
    },
    "content_id": {
      "title": "Content Id",
      "type": "string"
    },
    "actor_id": {
      "title": "Actor Id",
      "type": "string"
    },
    "space_id": {
      "title": "Space Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ContentKind"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "reply_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
